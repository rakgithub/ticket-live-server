# Synthetic credentials for the disposable Compose stack used by CI.
POSTGRES_USER=ticketlive_ci_admin
POSTGRES_PASSWORD=ci-postgres-admin-password
POSTGRES_DB=ticket_live
TICKETLIVE_PUBLIC_API_DB_PASSWORD=ci-public-api-db-password
TICKETLIVE_IDENTITY_DB_PASSWORD=ci-identity-db-password
TICKETLIVE_ORDER_DB_PASSWORD=ci-order-db-password
TICKETLIVE_EVENT_DB_PASSWORD=ci-event-db-password
TICKETLIVE_EMAIL_DB_PASSWORD=ci-email-db-password
TICKETLIVE_PAYMENT_DB_PASSWORD=ci-payment-db-password
TICKETLIVE_TICKETING_DB_PASSWORD=ci-ticketing-db-password

RABBITMQ_ADMIN_USER=ticketlive_ci_admin
RABBITMQ_ADMIN_PASSWORD=ci-rabbit-admin-password
TICKETLIVE_ORDER_AMQP_USER=ticketlive-order-ci
TICKETLIVE_ORDER_AMQP_PASSWORD=ci-order-amqp-password
TICKETLIVE_EMAIL_AMQP_USER=ticketlive-email-ci
TICKETLIVE_EMAIL_AMQP_PASSWORD=ci-email-amqp-password
TICKETLIVE_EVENT_AMQP_USER=ticketlive-event-ci
TICKETLIVE_EVENT_AMQP_PASSWORD=ci-event-amqp-password
TICKETLIVE_TICKETING_AMQP_USER=ticketlive-ticketing-ci
TICKETLIVE_TICKETING_AMQP_PASSWORD=ci-ticketing-amqp-password

JWT_SECRET=ci-container-smoke-jwt-secret-at-least-32-bytes
PUBLIC_API_ORDER_TOKEN=ci-public-api-order-token-0000000000000000
PUBLIC_API_EVENT_TOKEN=ci-public-api-event-token-0000000000000000
ORDER_EVENT_TOKEN=ci-order-event-token-000000000000000000000000
ORDER_PAYMENT_TOKEN=ci-order-payment-token-00000000000000000000
EMAIL_INTERNAL_TOKEN=ci-email-internal-token-000000000000000000
PUBLIC_API_TICKETING_TOKEN=ci-public-api-ticketing-token-0000000000000
TICKETING_CHECK_IN_TOKEN=ci-ticketing-check-in-token-000000000000000

GEMINI_API_KEY=ci-deterministic-gemini-key
EVENT_CHAT_MODEL=gemini-3.8-flash
EVENT_CHAT_TIMEOUT_MS=10000
OUTBOX_POLL_INTERVAL_MS=100
INVENTORY_HOLD_EXPIRY_POLL_INTERVAL_MS=100
INVENTORY_RECONCILIATION_INTERVAL_MS=1000
EMAIL_PROVIDER=fake
EMAIL_RETRY_DELAY_MS=1000
EMAIL_MAX_RETRIES=1
MOCK_PAYMENT_DELAY_MS=0
MOCK_PAYMENT_FAILURE_RATE=0
TICKETING_RETRY_DELAY_MS=1000
TICKETING_MAX_RETRIES=1
TICKETS_PORTAL_URL=http://localhost:3000/my-tickets
EMAIL_LEGACY_QUEUE_ENABLED=true
ORDER_SERVICE_TIMEOUT_MS=10000
PAYMENT_SERVICE_TIMEOUT_MS=10000
TICKETING_SERVICE_TIMEOUT_MS=10000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
