{
  "name": "ticket-live-server",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:public-api": "vitest run apps/public-api/src",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:outbox:integration": "vitest run --config vitest.outbox.integration.config.ts",
    "test:public-api:integration": "vitest run --config vitest.integration.config.ts apps/public-api/src",
    "test:contracts": "vitest run packages/contracts/src",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "start": "pnpm --filter @ticket-live/public-api start",
    "start:worker": "pnpm --filter @ticket-live/order-service worker",
    "start:email-service": "pnpm --filter @ticket-live/email-service start",
    "start:email-worker": "pnpm start:email-service",
    "start:payment-service": "pnpm --filter @ticket-live/payment-service start",
    "start:ticketing-service": "pnpm --filter @ticket-live/ticketing-service start",
    "start:analytics-service": "pnpm --filter @ticket-live/analytics-service start",
    "start:order-service": "pnpm --filter @ticket-live/order-service start",
    "start:event-service": "pnpm --filter @ticket-live/event-service start",
    "eval:event-chat": "node --import tsx/esm apps/public-api/src/chat/eventChatEval.ts",
    "event:rebuild-index": "pnpm --filter @ticket-live/event-service rebuild-index",
    "db:clear": "node --import tsx/esm scripts/clearDatabase.ts",
    "replay:order-confirmation": "pnpm --filter @ticket-live/order-service replay-confirmation",
    "replay:ticketing-orders": "pnpm --filter @ticket-live/order-service replay-tickets",
    "replay:ticketing-cancellations": "pnpm --filter @ticket-live/event-service replay-ticket-invalidations"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.24.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.24.0",
  "type": "module",
  "dependencies": {
    "@elastic/elasticsearch": "~9.5.1",
    "@google/genai": "^2.25.0",
    "@langchain/langgraph": "1.4.18",
    "@ticket-live/contracts": "workspace:*",
    "amqplib": "^2.2.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.2",
    "drizzle-orm": "1.0.0-rc.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/amqplib": "^0.10.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.4",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "^10.12.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4",
    "yaml": "2.9.1"
  }
}
