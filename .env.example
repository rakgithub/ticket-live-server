PORT=4002
EVENT_SERVICE_PORT=4003
EMAIL_SERVICE_PORT=4004
# Keep this runtime DSN password aligned with TICKETLIVE_PUBLIC_API_DB_PASSWORD.
DATABASE_URL=postgres://ticketlive_public_api:local-public-api-password@localhost:5433/ticket_live
# This migration/admin DSN must match POSTGRES_USER and POSTGRES_PASSWORD.
MIGRATION_DATABASE_URL=postgres://user:password@localhost:5433/ticket_live
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=ticket_live
# Temporary runtime role for the current integrated app; migrations use POSTGRES_USER.
TICKETLIVE_PUBLIC_API_DB_PASSWORD=local-public-api-password
# Local-only passwords for the future service-owned PostgreSQL schemas.
TICKETLIVE_IDENTITY_DB_PASSWORD=local-identity-password
TICKETLIVE_ORDER_DB_PASSWORD=local-order-password
TICKETLIVE_EVENT_DB_PASSWORD=local-event-password
TICKETLIVE_EMAIL_DB_PASSWORD=local-email-password
TICKETLIVE_NOTIFICATION_DB_PASSWORD=local-notification-password
ELASTICSEARCH_URL=http://localhost:9200
GEMINI_API_KEY=
EVENT_CHAT_MODEL=gemini-3.8-flash
EVENT_CHAT_TIMEOUT_MS=30000
EVENT_CHAT_MAX_ACTIVE_PER_USER=2
OUTBOX_POLL_INTERVAL_MS=2000
INVENTORY_HOLD_EXPIRY_POLL_INTERVAL_MS=2000
INVENTORY_RECONCILIATION_INTERVAL_MS=60000
EMAIL_RETRY_DELAY_MS=30000
EMAIL_MAX_RETRIES=5
EMAIL_LEGACY_QUEUE_ENABLED=true
EMAIL_PROVIDER=fake
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
INTERNAL_SERVICE_TOKEN=replace-with-a-random-internal-token-at-least-32-bytes-long
INVENTORY_SERVICE_URL=http://localhost:4003
EVENT_SERVICE_URL=http://localhost:4003
ACCESS_TOKEN_TTL=15m
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Set to the number of trusted reverse proxies in front of Express in production.
TRUST_PROXY_HOPS=0
AMQP_URL=amqp://guest:guest@localhost:5672
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
