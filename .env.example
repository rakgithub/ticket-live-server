PORT=4002
EVENT_SERVICE_PORT=4003
EMAIL_SERVICE_PORT=4004
ORDER_SERVICE_PORT=4005
PAYMENT_SERVICE_PORT=4006
TICKETING_SERVICE_PORT=4007
ANALYTICS_SERVICE_PORT=4008
# Keep this runtime DSN password aligned with TICKETLIVE_PUBLIC_API_DB_PASSWORD.
DATABASE_URL=postgres://ticketlive_public_api:local-public-api-password@localhost:5433/ticket_live
# Order service, outbox worker, and replay command use the Order-owned role.
ORDER_SERVICE_DATABASE_URL=postgres://ticketlive_order:local-order-password@localhost:5433/ticket_live
EVENT_SERVICE_DATABASE_URL=postgres://ticketlive_event:local-event-password@localhost:5433/ticket_live
EMAIL_SERVICE_DATABASE_URL=postgres://ticketlive_email:local-email-password@localhost:5433/ticket_live
PAYMENT_SERVICE_DATABASE_URL=postgres://ticketlive_payment:local-payment-password@localhost:5433/ticket_live
# This migration/admin DSN must match POSTGRES_USER and POSTGRES_PASSWORD.
MIGRATION_DATABASE_URL=postgres://user:password@localhost:5433/ticket_live
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=ticket_live
# Public API owns identity reads; Order keeps customer snapshots in its own schema.
TICKETLIVE_PUBLIC_API_DB_PASSWORD=local-public-api-password
# Local-only passwords for the service-owned PostgreSQL schemas.
TICKETLIVE_IDENTITY_DB_PASSWORD=local-identity-password
TICKETLIVE_ORDER_DB_PASSWORD=local-order-password
TICKETLIVE_EVENT_DB_PASSWORD=local-event-password
TICKETLIVE_EMAIL_DB_PASSWORD=local-email-password
TICKETLIVE_PAYMENT_DB_PASSWORD=local-payment-password
ELASTICSEARCH_URL=http://localhost:9200
GEMINI_API_KEY=
EVENT_CHAT_MODEL=gemini-3.8-flash
EVENT_CHAT_TIMEOUT_MS=30000
EVENT_CHAT_MAX_ACTIVE_PER_USER=2
OUTBOX_POLL_INTERVAL_MS=2000
INVENTORY_HOLD_EXPIRY_POLL_INTERVAL_MS=2000
INVENTORY_RECONCILIATION_INTERVAL_MS=60000
EMAIL_RETRY_DELAY_MS=30000
EMAIL_MAX_RETRIES=5
# Set false after the legacy booking-confirmation-email queue has been verified empty in Phase 4.
EMAIL_LEGACY_QUEUE_ENABLED=true
EMAIL_PROVIDER=fake
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
# Use independent random values for every service relationship in deployed environments.
PUBLIC_API_ORDER_TOKEN=replace-with-a-random-public-api-to-order-token
PUBLIC_API_EVENT_TOKEN=replace-with-a-random-public-api-to-event-token
ORDER_EVENT_TOKEN=replace-with-a-random-order-to-event-token
ORDER_PAYMENT_TOKEN=replace-with-a-random-order-to-payment-token
EMAIL_INTERNAL_TOKEN=replace-with-a-random-email-internal-token
ORDER_SERVICE_URL=http://localhost:4005
ORDER_SERVICE_TIMEOUT_MS=45000
PAYMENT_SERVICE_URL=http://localhost:4006
PAYMENT_SERVICE_TIMEOUT_MS=45000
INVENTORY_SERVICE_URL=http://localhost:4003
EVENT_SERVICE_URL=http://localhost:4003
ACCESS_TOKEN_TTL=15m
MOCK_PAYMENT_DELAY_MS=1500
MOCK_PAYMENT_FAILURE_RATE=0
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Set to the number of trusted reverse proxies in front of Express in production.
TRUST_PROXY_HOPS=0
RABBITMQ_ADMIN_USER=ticketlive-local-admin
RABBITMQ_ADMIN_PASSWORD=local-rabbit-admin-password
TICKETLIVE_ORDER_AMQP_USER=ticketlive-order
TICKETLIVE_ORDER_AMQP_PASSWORD=local-order-amqp-password
TICKETLIVE_EMAIL_AMQP_USER=ticketlive-email
TICKETLIVE_EMAIL_AMQP_PASSWORD=local-email-amqp-password
ORDER_AMQP_URL=amqp://ticketlive-order:local-order-amqp-password@localhost:5672/%2F
EMAIL_AMQP_URL=amqp://ticketlive-email:local-email-amqp-password@localhost:5672/%2F
RABBITMQ_AUTO_DECLARE_TOPOLOGY=true
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
